includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
    level: 8
    ignoreErrors:
        # Statamic v6 contracts (Statamic\Contracts\Entries\Entry, ...\Taxonomies\Term,
        # ...\Globals\GlobalSet, ...\Auth\User, etc.) are EMPTY marker interfaces —
        # the vendor facades type their returns against them while the real API lives
        # on the concrete classes (Statamic\Entries\Entry, LocalizedTerm, Variables).
        # Every method call through a contract type is therefore "undefined" to
        # PHPStan even though it exists at runtime. Scoped to vendor contract types
        # only: calls to undefined methods on OUR classes (Danielgnh\StatamicMcp\*)
        # still fail the build, so class-reference drift detection is intact.
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Statamic\\Contracts\\#'

        # Passport's Token model declares no @property docblocks for its table
        # attributes (user_id, client_id, ...), and larastan can only infer
        # model attributes from a live schema. Scoped to the one vendor model
        # in the one file that queries it raw.
        -
            identifier: property.notFound
            message: '#Laravel\\Passport\\Token#'
            path: src/OAuth/ConnectionRepository.php

        # Larastan accepts a view name only when view()->exists() finds it in
        # the app it boots for analysis, and that app never loads this addon,
        # so the statamic-mcp:: namespace Statamic registers at boot is unknown
        # to it. The page tests render both views. Scoped to the two
        # controllers that return them.
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$view of function view expects view-string\|null, string given\.$#'
            paths:
                - src/Http/Controllers/McpController.php
                - src/Http/Controllers/McpGuidelinesController.php
